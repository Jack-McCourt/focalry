APP_NAME="Focalry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=photography_platform
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Session / Cache / Queues ─────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (Resend / Postmark) ─────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourstudio.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# ─── Wasabi Object Storage ────────────────────────────────────────────────────
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_DEFAULT_REGION=us-east-1
WASABI_BUCKET=
WASABI_ENDPOINT=https://s3.wasabisys.com
WASABI_URL=
# BunnyCDN pull-zone hostname fronting the bucket (S3 Auth). Leave blank to
# stream public assets through the app. e.g. https://your-zone.b-cdn.net
WASABI_CDN_URL=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en

# ─── Google OAuth (Socialite) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Server key with the Places API enabled — powers the Google Reviews website block.
GOOGLE_PLACES_API_KEY=

# ─── Laravel Horizon ──────────────────────────────────────────────────────────
HORIZON_BASIC_AUTH_USERNAME=admin
HORIZON_BASIC_AUTH_PASSWORD=

# ─── Telescope ────────────────────────────────────────────────────────────────
TELESCOPE_ENABLED=true

# ─── Cloudflare CDN ───────────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ─── Custom domains ───────────────────────────────────────────────────────────
# Shown to studios as the DNS targets to point their domain at this server.
# TARGET = CNAME host for www/subdomains; IP = A record for apex domains.
CUSTOM_DOMAIN_TARGET=focalry.com
CUSTOM_DOMAIN_IP=

# ─── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
